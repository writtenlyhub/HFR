# =============================================================================
# Hotel Federation Environment Configuration
# =============================================================================

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL hosted on VPS or Local Docker)
DATABASE_URL="postgresql://hfr_user:hfr_password_2026@localhost:5432/hotel_federation?schema=public"

# Redis & Background Jobs (BullMQ)
REDIS_URL="redis://localhost:6379"

# NextAuth / Auth.js v5
AUTH_SECRET="f6c8d7e9b0a1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7"
AUTH_URL="http://localhost:3000"

# Google OAuth (Auth.js)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Razorpay Payment Gateway (Test Mode Only)
# NOTE: DevStay operates in Razorpay TEST MODE for staging and demonstrations.
# Secrets must stay strictly server-side. Amounts are computed in integer paise (1 INR = 100 paise).
# NEVER configure live merchant keys in non-production environments.
RAZORPAY_KEY_ID="rzp_test_your_test_key_id"
RAZORPAY_KEY_SECRET="your_test_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_test_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_test_key_id"

# Image Storage (Cloudinary / S3 compatible)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Channel Manager / Airbnb
AIRBNB_CLIENT_ID=""
AIRBNB_CLIENT_SECRET=""
AIRBNB_WEBHOOK_SECRET=""

# Instagram Graph API Integration (Official Meta API)
# Set INSTAGRAM_USE_MOCK="true" during development or until Meta authorization is completed.
INSTAGRAM_USE_MOCK="true"
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_USER_ID=""
INSTAGRAM_API_VERSION="v21.0"
INSTAGRAM_CACHE_TTL_SECONDS="1800"
NEXT_PUBLIC_INSTAGRAM_PROFILE_URL="https://instagram.com/devstays.jaipur"


